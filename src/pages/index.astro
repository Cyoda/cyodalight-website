---
/**
 * index.astro — Cyoda homepage.
 *
 * Section order:
 *   1. Header / nav        — in BaseLayout
 *   2. Hero                — HeroSection
 *   3. Proof bar           — ProofBar
 *   4. What it is          — WhatItIs
 *   5. Key capabilities    — FeatureGrid
 *   6. Get started         — QuickStart
 *   7. AI agent install    — AgentInstallTabs
 *   8. Developer Console   — DeveloperConsolePreview
 *   9. Growth path         — GrowthPath
 *  10. Two ways to use     — ProgressionDiagram
 *  11. FAQ                 — FAQSection
 *  12. Final CTA           — FinalCTA
 *  13. Footer              — in BaseLayout
 *
 * This file contains only section composition and data plumbing.
 * No layout logic lives here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import ProofBar from '../components/ProofBar.astro';
import WhatItIs from '../components/WhatItIs.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import QuickStart from '../components/QuickStart.astro';
import AgentInstallTabs from '../components/AgentInstallTabs.astro';
import DeveloperConsolePreview from '../components/DeveloperConsolePreview.astro';
import GrowthPath from '../components/GrowthPath.astro';
import ProgressionDiagram from '../components/ProgressionDiagram.astro';
import FAQSection from '../components/FAQSection.astro';
import FinalCTA from '../components/FinalCTA.astro';

import { features } from '../data/features';
---

<BaseLayout>
  <!-- 2. Hero -->
  <HeroSection />

  <!-- 3. Proof bar -->
  <ProofBar />

  <!-- 4. What it is -->
  <WhatItIs />

  <!-- 5. Key capabilities -->
  <section
    class="section section--alt"
    id="capabilities"
    aria-labelledby="capabilities-heading"
  >
    <div class="container">
      <h2 class="section-heading" id="capabilities-heading">What you get</h2>
      <FeatureGrid features={features} />
    </div>
  </section>

  <!-- 6. Get started -->
  <QuickStart />

  <!-- 7. AI coding agent install paths -->
  <AgentInstallTabs />

  <!-- 8. Developer Console preview -->
  <DeveloperConsolePreview />

  <!-- 9. Growth path — runtime mode progression -->
  <GrowthPath />

  <!-- 10. Two ways to use Cyoda -->
  <ProgressionDiagram />

  <!-- 11. FAQ -->
  <FAQSection />

  <!-- 12. Final CTA -->
  <FinalCTA />
</BaseLayout>
